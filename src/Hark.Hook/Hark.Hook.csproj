<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>HarkHook</AssemblyName>
    <Product>Hark</Product>
    <AssemblyTitle>Hark hooks for Claude Code on Windows</AssemblyTitle>
    <Description>Claude Code hooks for Hark when Claude Code runs on Windows (not in WSL)</Description>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RootNamespace>Hark.Hook</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hark.Core\Hark.Core.csproj" />
  </ItemGroup>

</Project>
